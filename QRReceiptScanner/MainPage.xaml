<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRReceiptScanner.MainPage"
             Title="Скенер рачуна"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="16" MaximumWidthRequest="520">

            <Label Text="Скенер рачуна"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label x:Name="SummaryLabel"
                   Text="Још нема сачуваних рачуна."
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Margin="0,8" />

            <Button Text="Скенирај QR код"
                    Clicked="OnScanClicked"
                    HeightRequest="56"
                    SemanticProperties.Hint="Отвара камеру за скенирање QR кода са рачуна" />

            <Button Text="Сви рачуни"
                    Clicked="OnListClicked"
                    HeightRequest="56"
                    SemanticProperties.Hint="Приказује све рачуне сачуване на овом уређају" />

            <Button Text="Артикли"
                    Clicked="OnArticlesClicked"
                    HeightRequest="56"
                    SemanticProperties.Hint="Приказује све купљене артикле из свих рачуна" />

            <Button Text="Статистика"
                    Clicked="OnStatisticsClicked"
                    HeightRequest="56"
                    SemanticProperties.Hint="Приказује потрошњу по месецима и годинама" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
