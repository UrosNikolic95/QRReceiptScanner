<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRReceiptScanner.Pages.ScanPage"
             Title="Скенирање QR кода">

    <Grid RowDefinitions="*,Auto">

        <!-- The camera view is created in code so that a machine without a camera
             never instantiates it. -->
        <Grid x:Name="CameraHost" Grid.Row="0" />

        <Label x:Name="CameraMessage"
               Grid.Row="0"
               Margin="24"
               IsVisible="False"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               LineBreakMode="WordWrap" />

        <!-- Live scanner diagnostics, drawn over the preview: frame size, frame rate,
             how many frames were analysed and the last decode attempt. -->
        <Label x:Name="DiagnosticsLabel"
               Grid.Row="0"
               Margin="8"
               Padding="6,3"
               IsVisible="False"
               FontFamily="Monospace"
               FontSize="10"
               TextColor="White"
               BackgroundColor="#99000000"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               InputTransparent="True" />

        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">

            <Label x:Name="StatusLabel"
                   Text="Усмери камеру ка QR коду на рачуну."
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

            <Button x:Name="StartCameraButton"
                    Text="Укључи камеру"
                    IsVisible="False"
                    Clicked="OnStartCameraClicked" />

            <!-- Low light is the usual reason a receipt code will not read. -->
            <Button x:Name="TorchButton"
                    Text="Упали лампу"
                    IsVisible="False"
                    Clicked="OnTorchClicked" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
